# =============================================================
# Vaelis Indoor — variáveis de ambiente
#
# As aspas abaixo valem para este arquivo, que é lido e tratado pela aplicação.
# Ao cadastrar em um painel (Vercel e afins), cole **apenas o valor**, sem as
# aspas: o painel guarda o texto literal, e uma variável "vazia" preenchida
# como "" viraria uma string de dois caracteres em vez de vazio. Variável sem
# valor: não cadastre a variável.
# =============================================================

# URL pública da aplicação. Usada para montar o redirect do Spotify.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Assinatura do cookie de sessão do painel. Mínimo 32 caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Senha do super admin criada pelo script de seed (npm run seed).
ADMIN_EMAIL="admin@vaelis.com.br"
ADMIN_INITIAL_PASSWORD=""

# -------------------------------------------------------------
# Firebase Firestore — banco de dados da plataforma
# -------------------------------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"
# Alternativa: cole o JSON inteiro da service account em uma linha.
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account", ...}'

# -------------------------------------------------------------
# Cloudflare R2 — armazenamento dos vídeos e imagens
# -------------------------------------------------------------
# O bucket precisa de acesso público de leitura (r2.dev ou domínio próprio) e
# de CORS liberando PUT a partir da origem da aplicação.
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="vaelis-indoor"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# -------------------------------------------------------------
# Spotify — trilha sonora das telas (Web Playback SDK)
# -------------------------------------------------------------
# Crie o app em https://developer.spotify.com/dashboard e cadastre o Redirect
# URI abaixo exatamente igual. A conta do estabelecimento precisa ser Premium.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://localhost:3000/api/auth/spotify/callback"

# -------------------------------------------------------------
# E-mail — link de redefinição de senha
# -------------------------------------------------------------
# Escolha UM caminho. Sem nenhum dos dois, o link é apenas escrito no console
# do servidor (serve para desenvolvimento, não para produção).
# O remetente precisa ser de um domínio verificado no provedor.
EMAIL_FROM="Vaelis Indoor <nao-responda@seudominio.com.br>"

# Opção A — Resend (https://resend.com), sem servidor SMTP próprio.
RESEND_API_KEY=""

# Opção B — SMTP comum (Google Workspace, Zoho, servidor da hospedagem).
# Porta 465 usa TLS direto; 587 usa STARTTLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# -------------------------------------------------------------
# Upstash Redis — rate limit de login e de pareamento (opcional)
# -------------------------------------------------------------
# Sem estas variáveis o rate limit é desativado e as rotas seguem funcionando.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -------------------------------------------------------------
# Sentry — monitoramento de erros (opcional)
# -------------------------------------------------------------
SENTRY_DSN=""
