datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
}

enum PlanCycle {
  MENSAL
  TRIMESTRAL
  ANUAL
}

enum AsaasPaymentStatus {
  PAID
  PENDING
  OVERDUE
}

enum TenantCategory {
  FOOD
  BARBER
  RETAIL
  SERVICES
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(TENANT_ADMIN)
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Tenant {
  id                 String         @id
  tenantName         String
  category           TenantCategory @default(FOOD)
  wifiSsid           String
  primaryColor       String         @default("#2563EB")
  pairingCode        String         @default("TV-0000")
  customDomain       String?        @unique
  tvDomain           String?        @unique
  domainStatus       String?        @default("PENDING")
  needsChrProvision  Boolean        @default(false)
  chrStatus          String?        @default("NOT_PROVISIONED")
  chrContainerId     String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  users                User[]
  addonStates          AddonState[]
  portalConfig         PortalConfig?
  tvConfig             TvConfig?
  radioIndoorConfig    RadioIndoorConfig?
  googleReviewsConfig GoogleReviewsConfig?
  whatsappBotConfig    WhatsappBotConfig?
  roletaSorteConfig    RoletaSorteConfig?
  webGuardConfig       WebGuardConfig?
  asaasConfig          AsaasConfig?
  products             Product[]
  sales                ProductSale[]
}

model AddonState {
  id                    String             @id @default(cuid())
  tenantId              String
  addonId               String
  active                Boolean            @default(false)
  subscriptionExpiresAt DateTime?
  planCycle             PlanCycle?         @default(MENSAL)
  paymentStatus         AsaasPaymentStatus @default(PENDING)
  asaasPaymentId        String?
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([tenantId, addonId])
}

model PortalConfig {
  id                        String         @id @default(cuid())
  tenantId                  String         @unique
  freeAccessEnabled         Boolean        @default(true)
  freeAccessDurationMinutes Int            @default(30)
  adWatchSeconds            Int            @default(15)
  digitalMenuEnabled        Boolean        @default(true)
  digitalMenuUrl            String         @default("")
  digitalMenuTitle          String         @default("Cardápio Digital")
  digitalMenuButtonText     String         @default("Ver Cardápio & Pedidos")
  digitalMenuIcon           String         @default("utensils")
  autoRedirectToMenu        Boolean        @default(false)
  tenant                    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  banners                   PortalBanner[]
  pixPlans                  PixPlan[]
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
}

model PortalBanner {
  id             String       @id @default(cuid())
  portalConfigId String
  title          String
  subtitle       String?
  imageUrl       String
  linkUrl        String?
  active         Boolean      @default(true)
  order          Int          @default(1)
  portalConfig   PortalConfig @relation(fields: [portalConfigId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model PixPlan {
  id             String       @id @default(cuid())
  portalConfigId String
  title          String
  durationText   String
  price          Float
  speedLimit     String
  recommended    Boolean      @default(false)
  portalConfig   PortalConfig @relation(fields: [portalConfigId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model TvConfig {
  id                      String        @id @default(cuid())
  tenantId                String        @unique
  showQrOverlay           Boolean       @default(true)
  showClockOverlay        Boolean       @default(true)
  showRadioBadge          Boolean       @default(true)
  showTitleOverlay        Boolean       @default(true)
  customCtaEnabled        Boolean       @default(false)
  customCtaTitle          String        @default("Siga nosso Instagram!")
  customCtaSubtitle       String        @default("Aponte a câmera do celular para conferir novidades e promoções.")
  customCtaUrl            String        @default("https://instagram.com")
  customCtaIntervalMinutes Int          @default(5)
  customCtaDurationSeconds Int          @default(15)
  autoRenew               Boolean       @default(true)
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playlist          TvMediaItem[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model TvMediaItem {
  id                 String   @id @default(cuid())
  tvConfigId         String
  title              String
  type               String   @default("image") // image | video
  url                String
  durationSeconds    Int      @default(10)
  active             Boolean  @default(true)
  muteVideoKeepRadio Boolean  @default(false)
  order              Int      @default(1)
  tvConfig           TvConfig @relation(fields: [tvConfigId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model RadioIndoorConfig {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  provider            String   @default("spotify")
  playlistUrl         String
  playlistName        String
  spotIntervalMinutes Int      @default(15)
  syncWithSmartTv     Boolean  @default(true)
  spotMessages        String   @default("[]") // JSON string com array de mensagens
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model GoogleReviewsConfig {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  googleMapsUrl      String
  minRatingForGoogle Int      @default(4)
  managerWhatsapp    String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model WhatsappBotConfig {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  otpType            String   @default("whatsapp")
  welcomeMessage     String
  capturedLeadsCount Int      @default(0)
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model RoletaSorteConfig {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  prizes    String   @default("[]") // JSON string dos prêmios e porcentagens
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebGuardConfig {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  blockAdultContent  Boolean  @default(true)
  blockTorrents       Boolean  @default(true)
  blockGambling      Boolean  @default(true)
  userSpeedLimitMbps Int      @default(10)
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AsaasConfig {
  id                    String   @id @default(cuid())
  tenantId              String   @unique
  walletId              String   @default("")
  apiKey                String   @default("")
  splitEnabled          Boolean  @default(true)
  splitPercentage       Float    @default(90.0) // Porcentagem do tenant (ex: 90%)
  platformFeePercentage Float    @default(10.0) // Porcentagem da plataforma (ex: 10%)
  accountStatus         String   @default("ACTIVE")
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Product {
  id          String        @id @default(cuid())
  tenantId    String
  name        String
  category    String        @default("Geral")
  price       Float
  stockQty    Int           @default(0)
  description String        @default("")
  imageUrl    String        @default("")
  active      Boolean       @default(true)
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales       ProductSale[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ProductSale {
  id             String   @id @default(cuid())
  tenantId       String
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String
  quantity       Int      @default(1)
  totalAmount    Float
  customerName   String   @default("Cliente Balcão")
  paymentStatus  String   @default("PAID")
  asaasPaymentId String?
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
